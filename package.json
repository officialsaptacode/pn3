{
  "name": "pn3",
  "version": "2.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "check": "turbo run check",
    "typecheck": "turbo run typecheck",
    "lint": "biome lint ",
    "format": "biome format --write .",
    "fix": "biome check --write .",
    "lint:errors": "biome check --diagnostic-level=error .",
    "ui": "pnpm --filter @workspace/ui ui add",
    "devAdmin": "pnpm -F admin dev",
    "devClient": "pnpm -F web dev",
    "devServer": "pnpm -F server dev",
    "build:server": "pnpm --filter server build",
    "build:web": "pnpm --filter web build",
    "start:server": "pnpm --filter server start:prod",
    "start:web": "pnpm --filter web start",
    "start:prod": "pnpm --parallel start:prod",
    "clean": "rimraf --glob \"**/node_modules\"",
    "db:generate": "pnpm -F server db:generate",
    "db:push": "pnpm -F server db:push",
    "db:migrate": "pnpm -F server db:migrate",
    "db:studio": "pnpm -F server db:studio",
    "db:seed": "pnpm -F server db:seed",
    "prepare": "husky",
    "test": "pnpm --filter server test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.8",
    "@playwright/test": "^1.58.2",
    "@workspace/typescript-config": "workspace:*",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.3",
    "turbo": "2.8.20",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.29.3",
  "pnpm": {
    "overrides": {
      "@types/react": "^19.2.7",
      "@types/react-dom": "^19.2.3"
    },
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@playwright/browser-chromium",
      "@prisma/client",
      "@prisma/engines",
      "@scarf/scarf",
      "@swc/core",
      "@tailwindcss/oxide",
      "argon2",
      "core-js-pure",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  },
  "engines": {
    "node": ">=24.12.0"
  }
}
