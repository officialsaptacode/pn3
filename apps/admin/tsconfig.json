{
  "extends": "../../packages/typescript-config/react-library.json",
  "compilerOptions": {
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"], // local admin source
      "@workspace/ui/lib/*": ["../../packages/ui/src/lib/*"],
      "@workspace/ui/css": ["../../packages/ui/src/styles/globals.css"],
      "@workspace/ui/*": ["../../packages/ui/src/components/*", "../../packages/ui/src/*"]
    },
    "outDir": "dist"
  },
  "include": ["src", "../../packages/ui/src"]
}
