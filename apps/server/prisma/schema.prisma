generator client {
  provider = "prisma-client-js"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int        @id @default(autoincrement())
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  email     String     @unique
  userName  String     @unique
  hash      String
  role      Role       @default(USER)
  hashedRt  String?
  avatarId  Int?
  avatar    Media?     @relation("UserAvatar", fields: [avatarId], references: [id])
  media     Media[]    @relation("UserMedia")

  smsTemplates SmsTemplate[]
  campaigns Campaign[]

  @@map("users")
}

model Media {
  id               Int                @id @default(autoincrement())
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  type             MediaType
  url              String
  filename         String             @default("unknown")
  mimeType         String             @default("application/octet-stream")
  size             Int                @default(0)
  width            Int?
  height           Int?
  thumbnailUrl     String?
  caption          String?
  altText          String?
  folder           String?
  s3Key            String             @default("")
  s3Bucket         String             @default("")
  displayOrder     Int                @default(0)
  uploadedBy       Int?
  user             User?              @relation("UserMedia", fields: [uploadedBy], references: [id])
  userAvatars      User[]             @relation("UserAvatar")

  campaigns        Campaign[]

  @@index([folder])
  @@index([type])
  @@index([createdAt])
  @@map("media")
}

model Setting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model Subscriber {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  email     String   @unique
  isActive  Boolean  @default(true)

  @@map("subscribers")
}

enum Role {
  ADMIN
  EDITOR
  USER
}

enum Status {
  ARCHIVE
  ACTIVE
  INACTIVE
}

enum MediaType {
  IMAGE
  VIDEO
}

model SmsTemplate {
  id          Int        @id @default(autoincrement())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  name        String
  content     String
  layaScore   Float?     // System 1 Spam probability score
  isApproved  Boolean    @default(false)
  userId      Int
  user        User       @relation(fields: [userId], references: [id])
  campaigns   Campaign[]

  @@map("sms_templates")
}

model Campaign {
  id             Int        @id @default(autoincrement())
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  name           String
  status         CampaignStatus @default(DRAFT)
  templateId     Int
  template       SmsTemplate @relation(fields: [templateId], references: [id])
  csvMediaId     Int?       // The uploaded CSV via Presigned URL
  csvMedia       Media?     @relation(fields: [csvMediaId], references: [id])
  userId         Int
  user           User       @relation(fields: [userId], references: [id])
  totalRows      Int        @default(0)
  processedRows  Int        @default(0)
  failedRows     Int        @default(0)
  smsJobs        SmsJob[]

  @@map("campaigns")
}

model SmsJob {
  id           Int        @id @default(autoincrement())
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  campaignId   Int
  campaign     Campaign   @relation(fields: [campaignId], references: [id])
  phoneNumber  String
  payload      Json       // The interpolated template or just the data used to map it
  status       SmsJobStatus @default(PENDING)
  error        String?

  @@index([campaignId])
  @@map("sms_jobs")
}

enum CampaignStatus {
  DRAFT
  QUEUED
  SENDING
  COMPLETED
  FAILED
}

enum SmsJobStatus {
  PENDING
  SENT
  FAILED
}
