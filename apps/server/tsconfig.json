{
  "extends": "@workspace/typescript-config/base.json",
  "compilerOptions": {
    "removeComments": true,
    "target": "ES2022",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "paths": {
      "@/*": ["src/*"]
    },
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "strictBindCallApply": false
  },
  "include": ["src", "test"]
}
