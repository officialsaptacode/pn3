# Database Configuration
DATABASE_URL="postgresql://user:password@localhost:5432/essential_trek"
DIRECT_URL="postgresql://user:password@localhost:5432/essential_trek"

# JWT Authentication
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-64-char-random-hex-string-change-this
JWT_SECRET_KEY=your-64-char-random-hex-string-change-this
JWT_REFRESH_SECRET=another-64-char-random-hex-change-this
JWT_REFRESH_SECRET_KEY=another-64-char-random-hex-change-this

# Internal Service-to-Service API Key
INTERNAL_API_KEY=your-internal-service-secret-key-change-this

# Application Settings
NODE_ENV=development

# CORS Configuration
# For production: Comma-separated list of allowed origins
# Example: https://frontend.vercel.app,https://admin.vercel.app
# For local dev: http://localhost:3000,http://localhost:5173
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# AWS S3 Configuration (for media uploads)
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# Email/SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Essential Trek <noreply@essentialtrek.com>"
# NVIDIA NIM API for AI Chat / RAG
NVIDIA_API_KEY=your_nvidia_api_key_here

# Cloudflare CLEF spam detection (System 1 classifier)
# Account ID: Cloudflare Dashboard -> Account -> Overview -> Account ID
# API token: My Profile -> API Tokens -> Create Token -> Workers AI: Run
CLOUDFLARE_ACCOUNT_ID=your_account_id_here
CLOUDFLARE_API_TOKEN=your_api_token_here
# Base URL only. The request URL becomes:
# {CLOUDFLARE_AI_BASE_URL}/{CLOUDFLARE_ACCOUNT_ID}/ai/run/@cf/cloudflare/clef
CLOUDFLARE_AI_BASE_URL=https://api.cloudflare.com/client/v4/accounts

# Send real SMS. "true" logs the message instead of calling AkashSMS.
DRY_RUN=true

# PageSpeed Insights (Performance Tracker)
# Get free key at https://console.cloud.google.com/apis/credentials -> enable PageSpeed Insights API
GOOGLE_PAGESPEED_API_KEY=your_google_pagespeed_api_key
GEMINI_API_KEY=your_key_here
# Optional: PAGESPEED_API_KEY alias also works

